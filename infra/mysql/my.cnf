[mysqld]
# default
# MySQL 8.4 で skip-host-cache は廃止されたため host_cache_size = 0 で代替する
host_cache_size = 0
skip-name-resolve
datadir = /var/lib/mysql
socket = /var/lib/mysql/mysql.sock
secure-file-priv = /var/lib/mysql-files
user = mysql

pid-file = /var/run/mysqld/mysqld.pid

# character set / collation
character_set_server = utf8mb4
collation_server = utf8mb4_ja_0900_as_cs_ks

# timezone
default-time-zone = SYSTEM
log_timestamps = SYSTEM

# Error Log
# コンテナではファイルに書かず標準エラーへ出力する（log-error を指定しない）。
# こうすることで `docker compose logs db` で起動エラーを確認できる。
# 以前は log-error = mysql-error.log としていたため、起動失敗時に
# 何も表示されず原因が追えなかった。

# Slow Query Log
# ログのパスは必ず絶対パスにすること。
# 相対パスだと公式イメージのentrypointが dirname で "." を取得し、
# ルート直下を chown -R しようとして起動に失敗する
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/mysql-slow.log
long_query_time = 1.0
log_queries_not_using_indexes = 0

# General Log
# 全クエリを記録するため負荷とディスク消費が大きい。既定はオフにし、
# クエリを追いたいときだけ 1 に変えて `docker compose restart db` する
general_log = 0
general_log_file = /var/lib/mysql/mysql-general.log

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4